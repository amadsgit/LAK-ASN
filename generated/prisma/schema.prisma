generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Instansi {
  id   Int    @id @default(autoincrement())
  nama String

  pegawai Pegawai[]
  users   User[]
}

model Pegawai {
  id         Int  @id @default(autoincrement())
  instansiId Int?

  foto         String?
  namaPegawai  String   @db.VarChar(100)
  nip          String   @unique @db.VarChar(18)
  tempatLahir  String   @db.VarChar(100)
  tanggalLahir DateTime
  jenisKelamin String   @db.VarChar(20)
  jabatan      String   @db.VarChar(50)
  pangkat      String   @db.VarChar(50)
  golongan     String   @db.VarChar(10)

  createdAt DateTime @default(now())

  instansi Instansi? @relation(fields: [instansiId], references: [id])
  user     User?     @relation("PegawaiUser")

  reports LakReport[]
}

model User {
  id         Int  @id @default(autoincrement())
  pegawaiId  Int  @unique
  instansiId Int?

  nip      String @unique @db.VarChar(18)
  password String
  role     Role   @default(PEGAWAI)

  createdAt DateTime @default(now())

  pegawai  Pegawai   @relation("PegawaiUser", fields: [pegawaiId], references: [id], onDelete: Cascade)
  instansi Instansi? @relation(fields: [instansiId], references: [id])
}

model LakReport {
  id        Int @id @default(autoincrement())
  pegawaiId Int

  bulan  Int
  tahun  Int
  status ReportStatus @default(DRAFT)

  totalJam      Float @default(0)
  totalKegiatan Int   @default(0)
  totalJamTJ    Float @default(0)
  totalJamTT    Float @default(0)

  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  approvedAt  DateTime?

  pegawai Pegawai     @relation(fields: [pegawaiId], references: [id])
  details LakDetail[]

  @@unique([pegawaiId, bulan, tahun])
  @@index([pegawaiId, tahun])
}

model LakDetail {
  id       Int @id @default(autoincrement())
  reportId Int

  tanggal    DateTime
  jenisTugas JenisTugas

  uraianKegiatan String
  volume         Float?
  satuan         String?
  output         String?

  jamMulai   String?
  jamSelesai String?
  durasiJam  Float

  createdAt DateTime @default(now())

  report LakReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

enum Role {
  PEGAWAI
  KASUBAG_TU
}

enum ReportStatus {
  DRAFT
  DIKIRIM
  DISETUJUI
}

enum JenisTugas {
  TJ
  TT
}
